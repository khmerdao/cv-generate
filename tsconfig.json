{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "noEmit": true,
        "types": ["vitest/globals", "@testing-library/jest-dom", "webpack-env"]
    },
    "include": ["assets/**/*.ts", "assets/**/*.tsx", "vitest.setup.ts"]
}
