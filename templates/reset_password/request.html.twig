{% extends 'layout/marketing.html.twig' %}
{% block content %}
<twig:Card title="{{ 'auth.forgot_password'|trans }}" class="mx-auto max-w-md">
    {{ form_start(form) }}
    {{ form_errors(form) }}
    <twig:Input :field="form.email" />
    {{ form_row(form.submit, {label: 'auth.send'|trans, attr: {class: 'inline-flex items-center justify-center rounded-full bg-ink px-6 py-3 text-sm font-semibold text-white transition hover:bg-ink/90'}}) }}
    {{ form_end(form) }}
</twig:Card>
{% endblock %}
