{% extends 'layout/marketing.html.twig' %}
{% block content %}
<twig:Card title="{{ 'auth.login'|trans }}" class="mx-auto max-w-md">
    {% if error %}<p class="form-error">{{ error.messageKey|trans(error.messageData, 'security') }}</p>{% endif %}
    <form method="post" class="space-y-4">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <label class="block text-sm">
            <span class="mb-1 block font-medium text-ink">{{ 'auth.email'|trans }}</span>
            <input type="email" name="_username" value="{{ last_username }}" required autofocus
                   class="block w-full rounded-xl border border-surface-line px-4 py-2.5 text-sm focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30">
        </label>
        <label class="block text-sm">
            <span class="mb-1 block font-medium text-ink">{{ 'auth.password'|trans }}</span>
            <input type="password" name="_password" required
                   class="block w-full rounded-xl border border-surface-line px-4 py-2.5 text-sm focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30">
        </label>
        <label class="flex items-center gap-2 text-sm text-ink-muted">
            <input type="checkbox" name="_remember_me"> {{ 'auth.remember_me'|trans }}
        </label>
        <twig:Button type="submit" class="w-full">{{ 'auth.login'|trans }}</twig:Button>
    </form>
    <div class="mt-4 flex justify-between text-sm">
        <a class="text-accent hover:text-accent-hover" href="{{ path('app_register') }}">{{ 'auth.register'|trans }}</a>
        <a class="text-accent hover:text-accent-hover" href="{{ path('app_forgot_password_request') }}">{{ 'auth.forgot_password'|trans }}</a>
    </div>
</twig:Card>
{% endblock %}
